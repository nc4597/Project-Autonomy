# Server
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Postgres (Railway injects DATABASE_URL automatically once the Postgres
# plugin is attached to this service; this is the local docker-compose value)
DATABASE_URL=postgresql://regiment:regiment@localhost:5432/regiment_kyc

# Must match the deployed frontend origin exactly (CORS)
FRONTEND_ORIGIN=http://localhost:3000

# S3-compatible object storage. Local dev points at the docker-compose
# MinIO instance; in Railway/production point these at a real bucket
# (AWS S3, Cloudflare R2, etc).
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=kyc-verification-documents
S3_ACCESS_KEY_ID=regiment
S3_SECRET_ACCESS_KEY=regiment123
S3_FORCE_PATH_STYLE=true

# HubSpot integration (stubbed until real credentials exist).
# Leaving these unset is intentional and supported: HubSpot sync will
# mark itself NOT_CONFIGURED and log a warning rather than failing.
# Required private-app scopes: crm.objects.contacts.read,
# crm.objects.contacts.write, crm.objects.notes.write, files, crm.associations.write
HUBSPOT_ACCESS_TOKEN= 
HUBSPOT_PORTAL_ID= 
# GUID of the target HubSpot Form (Marketing > Forms > your form >
# Actions > Embed, or in the form's URL). Required for the active
# native-form submission path (services/hubspotFormService.ts).
HUBSPOT_FORM_GUID= 

# Shared secret required to call POST /internal/hubspot/retry-sweep
# (set this as a Railway Cron Job's request header, x-internal-secret)
INTERNAL_SWEEP_SECRET=

# Shared secret apps/admin uses (as the x-admin-secret header) to call
# the read-only /api/admin/* routes for KYC compliance review. Must
# match KYC_API_ADMIN_SECRET in apps/admin/.env exactly.
ADMIN_API_SECRET=local-dev-admin-secret

# Admin notification email, sent on every submission (stubbed until
# configured — same NOT_CONFIGURED-safe pattern as HubSpot above).
RESEND_API_KEY=
# Comma-separated for multiple recipients.
ADMIN_NOTIFICATION_EMAILS=
# Resend's shared sandbox sender (works without verifying a domain, fine
# for testing). Swap for a verified sender on your own domain before
# sending real notifications.
EMAIL_FROM_ADDRESS=onboarding@resend.dev
