// Second, independent Prisma schema/client inside apps/admin — the KYC
// data deliberately stays in its own database (regiment_kyc), separate
// from this app's own CMS database (regiment_admin). Two schemas, two
// generated clients, one Next.js app. See src/lib/kyc/prisma.ts for the
// client that imports from the custom output path below.
generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/kyc-client"
}

datasource db {
  provider = "postgresql"
  url      = env("KYC_DATABASE_URL")
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
}

enum InvestorType {
  INDIVIDUAL
  JOINT
  ENTITY_TRUST
}

// SourceOfFunds is intentionally NOT an enum: its options are editable
// from the admin Verification Form editor (VerificationFormConfig), so
// KycAmlInfo.sourceOfFunds stores the option's display label as text.

enum AccreditationMethod {
  ANNUAL_INCOME
  NET_WORTH
  PROFESSIONAL_CERTIFICATION
  ENTITY_QUALIFICATION
  KNOWLEDGEABLE_EMPLOYEE
}

enum DocumentCategory {
  ID_FRONT
  ID_BACK
  CO_OWNER_ID_FRONT
  CO_OWNER_ID_BACK
  PROOF_OF_ADDRESS
  ENTITY_FORMATION_DOC
  INCOME_TAX_RETURN
  BROKERAGE_STATEMENT
  BANK_STATEMENT
  CPA_NET_WORTH_LETTER
  FINRA_CRD_OR_LICENSE
  ENTITY_FINANCIALS_OR_TAX_RETURNS
  CAP_TABLE
  EMPLOYMENT_VERIFICATION_OR_FUND_CERT
}

enum DocumentStatus {
  PENDING
  UPLOADED
  REJECTED
}

enum ReviewStatus {
  PENDING
  VERIFIED
  REJECTED
}

model VerificationSubmission {
  id          String           @id @default(uuid())
  dealId      String
  status      SubmissionStatus @default(DRAFT)
  currentStep Int              @default(1)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  // Compliance decision made on the admin detail page. Rejection stores
  // the reviewer's notes (emailed to the investor verbatim) and flips
  // status back to DRAFT so the investor can revise and resubmit;
  // resubmitting resets the review to PENDING.
  reviewStatus ReviewStatus @default(PENDING)
  reviewNotes  String?
  reviewedAt   DateTime?
  // Audit: the signed-in reviewer (Microsoft account email) who made
  // the decision. Reset with the rest of the review on resubmission.
  reviewedBy   String?
  // Compliance audit: submittedAt is the LATEST (re)submission;
  // firstSubmittedAt is set on the original submission and never
  // overwritten by resubmissions after rejection.
  submittedAt DateTime?
  firstSubmittedAt DateTime?
  // Browser-held draft access key. Issued at creation, required on all
  // draft reads/saves; null only for drafts created before keys existed
  // (grandfathered). Re-issued to new devices via the identity-challenge
  // unlock endpoint.
  clientSecret String?

  // Bookkeeping for the HubSpot contact-card sync (see
  // lib/kyc/hubspotContactService.ts) — deliberately plain columns, not
  // a separate sync table: one contact card per submission, deduped by
  // email on HubSpot's side, so there's no retry state machine to model.
  hubspotContactId String?
  hubspotSyncedAt  DateTime?
  hubspotSyncError String?

  // Returning-investor fast-track (see lib/kyc/fastTrackService.ts): set
  // when this submission was auto-verified from a still-valid prior
  // accreditation instead of going through the wizard + manual review.
  // fastTrackedFromId is a plain reference (like the HubSpot columns
  // above) to the source submission's id — no FK, since it may point
  // across deals and the source could later be deleted without this
  // record needing to change.
  fastTracked      Boolean @default(false)
  fastTrackedFromId String?

  contactInfo   ContactInfo?
  kycAmlInfo    KycAmlInfo?
  accreditation AccreditationInfo?
  certification CertificationAcceptance?
  documents     Document[]
  customAnswers CustomAnswer[]

  @@index([dealId])
}

// Answers to admin-defined custom fields (see VerificationFormConfig).
// The answer stores the display value the investor picked/typed, keyed
// by the config field's stable key.
model CustomAnswer {
  id           String   @id @default(uuid())
  submissionId String
  submission   VerificationSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  fieldKey     String
  label        String
  value        String
  updatedAt    DateTime @updatedAt

  @@unique([submissionId, fieldKey])
}

// Singleton row holding the investor verification form's configuration
// as JSON (see src/lib/kyc/formConfig.ts for the shape + validation).
// `draft` is what the admin editor works on; `published` is what the
// public wizard renders. Publishing copies draft -> published.
model VerificationFormConfig {
  id          String    @id @default(uuid())
  draft       Json
  published   Json
  publishedAt DateTime?
  updatedAt   DateTime  @updatedAt
}

enum TaxIdType {
  SSN
  ITIN
}

model ContactInfo {
  id             String   @id @default(uuid())
  submissionId   String   @unique
  submission     VerificationSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  firstName      String
  lastName       String
  email          String
  phone          String
  dateOfBirth    DateTime @db.Date
  // The primary applicant's own tax ID — SSN for most individuals, TIN
  // for e.g. non-resident aliens who don't have one. Still only ever the
  // last 4 digits, regardless of type. Defaults to SSN so existing rows
  // (all collected before TIN existed as an option) stay accurate.
  taxIdType      TaxIdType @default(SSN)
  taxIdLast4     String
  streetAddress  String
  city           String
  state          String
  zipCode        String
  investorType   InvestorType

  // Entity / Trust — populated only when investorType = ENTITY_TRUST.
  // The heavier entity-specific paperwork (formation doc, financials,
  // cap table) is collected separately in the Accreditation step.
  entityName       String?
  entityTaxIdLast4 String?

  // Joint Account co-owner — populated only when investorType = JOINT.
  // The co-owner is verified to the same standard as the primary
  // applicant (their own name/email/DOB/tax ID), not just recorded by
  // name.
  coOwnerFirstName   String?
  coOwnerLastName    String?
  coOwnerEmail       String?
  coOwnerDateOfBirth DateTime?  @db.Date
  coOwnerTaxIdType   TaxIdType?
  coOwnerTaxIdLast4  String?
  coOwnerStreetAddress String?
  coOwnerCity          String?
  coOwnerState         String?
  coOwnerZipCode       String?

  updatedAt      DateTime @updatedAt
}

model KycAmlInfo {
  id                   String   @id @default(uuid())
  submissionId         String   @unique
  submission           VerificationSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  countryOfCitizenship String
  taxResidence         String
  sourceOfFunds        String
  updatedAt            DateTime @updatedAt
}

model AccreditationInfo {
  id           String   @id @default(uuid())
  submissionId String   @unique
  submission   VerificationSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  method       AccreditationMethod
  updatedAt    DateTime @updatedAt
}

model Document {
  id               String           @id @default(uuid())
  submissionId     String
  submission       VerificationSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  category         DocumentCategory
  s3Key            String
  originalFilename String
  mimeType         String
  sizeBytes        Int?
  status           DocumentStatus   @default(PENDING)
  rejectionReason  String?
  createdAt        DateTime         @default(now())
  confirmedAt      DateTime?

  @@index([submissionId])
  @@index([submissionId, category])
}

model CertificationAcceptance {
  id           String   @id @default(uuid())
  submissionId String   @unique
  submission   VerificationSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  acceptedAt   DateTime
  tosVersion   String
  ipAddress    String
  userAgent    String
}
