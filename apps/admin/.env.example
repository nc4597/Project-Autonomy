# Local dev: matches the postgres-admin service in docker-compose.yml
DATABASE_URL=postgresql://regiment:regiment@localhost:5433/regiment_admin

# Origin allowed to call the public read endpoints (apps/web).
FRONTEND_ORIGIN=http://localhost:3000

# ---- Admin sign-in (Microsoft Entra ID / "Sign in with Microsoft") ----
# From the Azure app registration: Application (client) ID, Directory
# (tenant) ID, and a client secret's Value (not its Secret ID). Who's
# actually let in beyond "has a Regiment Microsoft account" is controlled
# separately, via the AdminUser table (see the Admin Access screen).
APPLICATION_ID=
TENANT_ID=
SECRET_VALUE=
# Encrypts/signs Auth.js's own session cookie — unrelated to the Entra
# secret above. Generate a random value per environment, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Local dev: matches the minio service in docker-compose.yml
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=regiment-marketplace-assets
S3_ACCESS_KEY_ID=regiment
S3_SECRET_ACCESS_KEY=regiment123
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000/regiment-marketplace-assets

# ---- KYC/AML verification flow (merged in from the former apps/api) ----
# Own database, deliberately separate from DATABASE_URL above. Local
# dev: matches the postgres service (not postgres-admin) in
# docker-compose.yml.
KYC_DATABASE_URL=postgresql://regiment:regiment@localhost:5432/regiment_kyc

# Own S3-compatible bucket for uploaded KYC documents — private,
# compliance-gated, distinct from the public marketing S3_* above.
KYC_S3_ENDPOINT=http://localhost:9000
KYC_S3_REGION=us-east-1
KYC_S3_BUCKET=kyc-verification-documents
KYC_S3_ACCESS_KEY_ID=regiment
KYC_S3_SECRET_ACCESS_KEY=regiment123
KYC_S3_FORCE_PATH_STYLE=true

# Public origin of this admin app itself (e.g.
# https://regimentadmin-production.up.railway.app) — used to deep-link
# the notification email straight to a submission's review page.
ADMIN_APP_ORIGIN=

# HubSpot private-app token for the contact-card sync (one deduped-by-
# email contact card per investor on submission). Only needs the
# crm.objects.contacts.read + crm.objects.contacts.write scopes.
# Leaving it unset skips the sync loudly; submissions are unaffected.
HUBSPOT_ACCESS_TOKEN=
# Numeric portal ID — only used to build the "View in HubSpot" link to a
# synced contact card on the admin KYC detail page.
HUBSPOT_PORTAL_ID=

# Admin notification email on every KYC submission. We POST to a Zapier
# "Catch Hook" webhook URL; the Zap sends the actual email through a
# connected real mailbox (Gmail/Outlook), so no sending-domain/DNS setup
# is needed here. Stubbed (skipped) until both are set.
ZAPIER_KYC_NOTIFICATION_WEBHOOK_URL=
ADMIN_NOTIFICATION_EMAILS=

# Cloudflare Turnstile secret key — verifies the Review & Submit
# security-check token server-side. Pairs with the web app's
# NEXT_PUBLIC_TURNSTILE_SITE_KEY. Leaving unset skips verification
# loudly; submissions are unaffected.
TURNSTILE_SECRET_KEY=

# Comma-separated Microsoft account emails allowed to use the KYC
# Compliance Review (Verify/Reject) — e.g. Rob's. All admins still sign
# in with Microsoft as usual; this only gates the review controls.
# Leaving unset lets every signed-in admin review.
COMPLIANCE_REVIEWER_EMAILS=

# Separate Zapier "Catch Hook" for investor rejection emails (the Zap
# maps to/subject/html from the payload; `to` is the investor). Keeps
# its recipient and sending mailbox independent from the admin
# notification Zap above. Unset = rejection emails skip loudly and the
# review UI shows that the email didn't send.
ZAPIER_KYC_REJECTION_WEBHOOK_URL=

# Third Zapier Catch Hook: verified notification to the deal's rep
# (To = the deal's Rep Email, CC below, signed Robert J. Khoury).
# Unset = verified emails skip loudly; the review panel shows it.
ZAPIER_KYC_VERIFIED_WEBHOOK_URL=
# CC on every verified email (comma-separate for multiple).
# Defaults to ir@regimentsecurities.com when unset.
VERIFIED_EMAIL_CC=
