# Local dev: matches the postgres-admin service in docker-compose.yml
DATABASE_URL=postgresql://regiment:regiment@localhost:5433/regiment_admin

# Origin allowed to call the public read endpoints (apps/web).
FRONTEND_ORIGIN=http://localhost:3000

# ---- Admin sign-in (Microsoft Entra ID / "Sign in with Microsoft") ----
# From the Azure app registration: Application (client) ID, Directory
# (tenant) ID, and a client secret's Value (not its Secret ID). Who's
# actually let in beyond "has a Regiment Microsoft account" is controlled
# separately, via the AdminUser table (see the Admin Access screen).
APPLICATION_ID=
TENANT_ID=
SECRET_VALUE=
# Encrypts/signs Auth.js's own session cookie — unrelated to the Entra
# secret above. Generate a random value per environment, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Local dev: matches the minio service in docker-compose.yml
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=regiment-marketplace-assets
S3_ACCESS_KEY_ID=regiment
S3_SECRET_ACCESS_KEY=regiment123
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000/regiment-marketplace-assets

# ---- KYC/AML verification flow (merged in from the former apps/api) ----
# Own database, deliberately separate from DATABASE_URL above. Local
# dev: matches the postgres service (not postgres-admin) in
# docker-compose.yml.
KYC_DATABASE_URL=postgresql://regiment:regiment@localhost:5432/regiment_kyc

# Own S3-compatible bucket for uploaded KYC documents — private,
# compliance-gated, distinct from the public marketing S3_* above.
KYC_S3_ENDPOINT=http://localhost:9000
KYC_S3_REGION=us-east-1
KYC_S3_BUCKET=kyc-verification-documents
KYC_S3_ACCESS_KEY_ID=regiment
KYC_S3_SECRET_ACCESS_KEY=regiment123
KYC_S3_FORCE_PATH_STYLE=true

# HubSpot integration (stubbed until real credentials exist — leaving
# these unset is intentional and supported). Required private-app
# scopes: crm.objects.contacts.read, crm.objects.contacts.write,
# crm.objects.notes.write, files, crm.associations.write
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_GUID=
# Root /kyc-verifications folder's numeric ID in the file manager (from
# its URL, e.g. ?folderId=123) — used to link straight to it in the
# admin notification email.
HUBSPOT_KYC_ROOT_FOLDER_ID=

# Admin notification email on every KYC submission. We POST to a Zapier
# "Catch Hook" webhook URL; the Zap sends the actual email through a
# connected real mailbox (Gmail/Outlook), so no sending-domain/DNS setup
# is needed here. Stubbed (skipped) until both are set.
ZAPIER_KYC_NOTIFICATION_WEBHOOK_URL=
ADMIN_NOTIFICATION_EMAILS=

# Static link to the accredited-investor certification document Rob
# signs after reviewing a submission (same link in every email — not a
# real PandaDoc API integration). Leaving unset renders as placeholder
# text in the email instead of a broken link.
PANDADOC_CERTIFICATION_TEMPLATE_URL=

# Shared secret required (x-internal-secret header) to call the HubSpot
# retry-sweep route (set this as a Railway Cron Job's request header).
INTERNAL_SWEEP_SECRET=
