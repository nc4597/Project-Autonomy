# Base URL of the apps/api backend service (no trailing slash)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Base URL of the apps/admin service, which also serves the public
# read-only deal/site-settings API this site's Home/Deals/deal pages
# fetch from (no trailing slash)
NEXT_PUBLIC_ADMIN_API_BASE_URL=http://localhost:3100
