# Base URL of the apps/admin service — it serves both the public
# read-only deal/site-settings API (Home/Deals/deal pages) and, since
# the KYC/AML flow merged into apps/admin, the /api/public/kyc/*
# endpoints the verification wizard calls directly from the browser
# (no trailing slash).
NEXT_PUBLIC_ADMIN_API_BASE_URL=http://localhost:3100

# Cloudflare Turnstile site key (public) for the security check popup on
# Review & Submit. Inlined at build time — on Railway this must be set
# before the build. Unset = popup skipped, submissions work normally.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
